# ==============================================================================
# SHAFSKY AVIATION FASTAPI BACKEND - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy to `.env` for local development. On AWS inject via Secrets Manager / SSM —
# never bake secrets into the Docker image.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION
# ------------------------------------------------------------------------------
# development | staging | production  (anything except development/dev/test → prod hardening)
ENVIRONMENT=development
PORT=8003
BIND_HOST=127.0.0.1
PROJECT_NAME="Shafsky Aviation FastAPI Backend Engine"
# Docker/ECS: uvicorn workers via gunicorn
WEB_CONCURRENCY=2
RUN_MIGRATIONS=true
# Opt-in only: applies best-effort schema ALTERs at startup. Leave false on AWS
# and rely on alembic migrations instead.
RUN_STARTUP_SCHEMA_PATCHES=false

# ------------------------------------------------------------------------------
# 2. DATABASE & REDIS
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://your_db_user:your_db_password@your_db_host:5432/your_db_name?sslmode=require
TEST_DATABASE_URL=postgresql://shafsky:shafsky@127.0.0.1:55432/shafsky_test
SHAFSKY_ALLOW_PROD_DB_TESTS=false

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Optional explicit URL (overrides host/port/password). Include auth if needed:
# REDIS_URL=redis://:password@host:6379/0
REDIS_URL=
# Required for multi-instance AWS (ECS tasks). Fail readiness if Redis is down.
REQUIRE_REDIS=false

# ------------------------------------------------------------------------------
# 3. CORS & PROXY
# ------------------------------------------------------------------------------
# Exact frontend origins only (comma-separated). In production the localhost
# regex fallback is disabled, so these must list every real frontend origin.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
CORS_ALLOW_CREDENTIALS=true
# Set true behind AWS ALB / CloudFront so rate limits use X-Forwarded-For
TRUST_PROXY=false

# ------------------------------------------------------------------------------
# 4. JWT (RS256 required in staging/production)
# ------------------------------------------------------------------------------
JWT_ALGORITHM=RS256
# PEM contents (use \n for newlines in env vars, or multiline secrets in AWS)
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_PREVIOUS_PUBLIC_KEYS=
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_min_32_chars_placeholder
# Only needed if ALLOW_HS256_LEGACY_FALLBACK=true (forbidden in production)
JWT_SECRET=
ALLOW_HS256_LEGACY_FALLBACK=false
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

ADMIN_EMAIL=admin@shafskyaviation.com
ADMIN_PASSWORD=your_super_admin_password_placeholder
# Never enable in production
ALLOW_ADMIN_BOOTSTRAP=false

# ------------------------------------------------------------------------------
# 5. EMAIL (Resend)
# ------------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=bookings@yourdomain.com
RESEND_FROM_EMAIL=bookings@yourdomain.com
EMAIL_REPLY_TO=support@yourdomain.com
ADMIN_NOTIFICATION_EMAILS=ops@yourdomain.com

# ------------------------------------------------------------------------------
# 6. WHATSAPP (Meta Cloud API)
# ------------------------------------------------------------------------------
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0
# E.164 without + (e.g. 9198XXXXXXXX). Empty = skip officer notifications.
WHATSAPP_OFFICER_NOTIFY_PHONE=

# ------------------------------------------------------------------------------
# 7. PAYMENTS (Razorpay)
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYMENT_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# 8. STORAGE (optional invoice uploads)
# ------------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=

# ------------------------------------------------------------------------------
# 9. FLIGHT DATA PROVIDERS
# ------------------------------------------------------------------------------
AVIATION_EDGE_API_KEY=
AVIATION_EDGE_BASE_URL=https://aviation-edge.com/v2/public
AVIATIONSTACK_API_KEY=
AVIATIONSTACK_BASE_URL=https://api.aviationstack.com/v1

# ------------------------------------------------------------------------------
# 10. OPTIONAL AI
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
